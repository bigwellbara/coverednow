# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coverednow?schema=public"

# Payments (Paynow): fill in once your merchant account is approved
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
PAYNOW_RESULT_URL="http://localhost:3000/api/webhooks/paynow"
PAYNOW_RETURN_URL="http://localhost:3000/payments/return"
# The gateway's percentage, passed on to the donor so the school gets the full
# amount. Set it from your Paynow agreement: 2.5 is only an estimate.
PAYMENT_FEE_PERCENT="2.5"
# Leave both Paynow keys empty in development to use the payment simulator.

# Signing secret for school confirmation links
CONFIRMATION_TOKEN_SECRET="change-me"

# Sign-in. Generate each secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
OTP_SECRET="change-me"

# Private documents (IDs, fee statements). Keep the directory out of anything served.
DOCUMENT_STORAGE_DIR=".data/documents"
# Must decode to exactly 32 bytes. Losing this key makes stored documents unreadable.
DOCUMENT_ENCRYPTION_KEY="change-me"

# Sign-in codes and bursar links. Set to "whatsapp" after: npm run whatsapp:pair
# Leave empty in development to print messages in the terminal instead.
MESSAGE_DELIVERY=""
# The linked WhatsApp session. Keep this private: it gives access to the account.
WHATSAPP_AUTH_DIR=".data/whatsapp-auth"

# Encrypts school payout details. Must decode to exactly 32 bytes. Back it up:
# losing this key means re-entering every school's payout details.
PAYOUT_ENCRYPTION_KEY="change-me"

# Email sign-in codes, through any SMTP provider. Leave SMTP_HOST empty in
# development to print them in the terminal instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Where enquiries from the For partners page are sent. Falls back to EMAIL_FROM.
PARTNERS_EMAIL=""
