generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  GUARDIAN
  DONOR
  SCHOOL_CONTACT
  ADMIN
  SPONSOR
}

enum BillStatus {
  DRAFT
  PENDING_SCHOOL
  SCHOOL_CONFIRMED
  PARTIALLY_FUNDED
  FUNDED
  PAID
  RECEIPT_CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED
  DISPUTED
}

enum BillCategory {
  SCHOOL_FEES
}

enum Visibility {
  PUBLIC
  ALIAS
  ANONYMOUS
}

enum BillerType {
  UNIVERSITY
  COLLEGE
  HIGH_SCHOOL
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  CORRECTED
  REJECTED
  RECEIPT
}

enum VerificationDocumentKind {
  NATIONAL_ID
  BIRTH_CERTIFICATE
  STUDENT_ID
  ENROLLMENT_LETTER
}

enum DonationStatus {
  INITIATED
  SETTLED
  FAILED
  REFUNDED
}

enum UpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------- identity

model User {
  id           String        @id @default(cuid())
  role         Role
  phone        String        @unique
  email        String?
  name         String
  createdAt    DateTime      @default(now())
  verification Verification?
  donorProfile DonorProfile?
  students     Student[]
}

// The person whose fees are being paid. A university student owns their own
// record; a guardian owns the record of the high school student in their care.
model Student {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  firstName String
  lastName  String
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  ipHash     String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
}

model Verification {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  user            User                   @relation(fields: [userId], references: [id])
  status          VerificationStatus     @default(PENDING)
  // Null while the owner is still preparing it, or after a rejection.
  submittedAt     DateTime?
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())
  documents       VerificationDocument[]

  @@index([status, submittedAt])
}

model VerificationDocument {
  id             String                   @id @default(cuid())
  verificationId String
  verification   Verification             @relation(fields: [verificationId], references: [id])
  kind           VerificationDocumentKind
  storageKey     String                   @unique
  mimeType       String
  sizeBytes      Int
  // Hash of the original file. Unique so one document cannot back two accounts.
  sha256         String                   @unique
  createdAt      DateTime                 @default(now())

  @@unique([verificationId, kind])
}

// ----------------------------------------------------------------- billing

model Biller {
  id            String          @id @default(cuid())
  name          String
  type          BillerType
  city          String
  verified      Boolean         @default(false)
  // Set by admins only, and may be added after the school is created.
  payoutMethod  String?
  // Encrypted. Read it through the billing module, never directly.
  payoutDetails Json?
  contacts      BillerContact[]
  bills         Bill[]
  createdAt     DateTime        @default(now())
}

model BillerContact {
  id               String             @id @default(cuid())
  billerId         String
  biller           Biller             @relation(fields: [billerId], references: [id])
  name             String
  phone            String
  email            String?
  roleTitle        String
  verifiedAt       DateTime?
  verifiedBy       String?
  // How the contact was checked, such as a call to the school's listed number.
  verificationNote String?
  // Kept rather than deleted, because past confirmations refer to contacts.
  removedAt        DateTime?
  confirmations    BillConfirmation[]

  @@index([billerId])
}

model Bill {
  id              String             @id @default(cuid())
  ownerId         String
  studentId       String
  billerId        String
  biller          Biller             @relation(fields: [billerId], references: [id])
  regNumber       String
  term            String
  claimedAmount   Decimal            @db.Decimal(12, 2)
  confirmedAmount Decimal?           @db.Decimal(12, 2)
  currency        String             @default("USD")
  category        BillCategory       @default(SCHOOL_FEES)
  dueDate         DateTime
  documentKey     String
  documentHash    String
  status          BillStatus         @default(DRAFT)
  closedReason    String?
  confirmations   BillConfirmation[]
  donations       Donation[]
  payout          Payout?
  updates         StudentUpdate[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Three more uniqueness rules live in the migrations as partial indexes, because
  // Prisma cannot express them: while a bill is active, there is one per school,
  // reg number and term, one per student and term, and one per fee statement. A
  // rejected or withdrawn bill frees them, so a fake bill cannot block a real one.
  @@index([status])
  @@index([studentId])
}

model BillConfirmation {
  id              String             @id @default(cuid())
  billId          String
  bill            Bill               @relation(fields: [billId], references: [id])
  contactId       String
  contact         BillerContact      @relation(fields: [contactId], references: [id])
  status          ConfirmationStatus @default(PENDING)
  confirmedAmount Decimal?           @db.Decimal(12, 2)
  sentAt          DateTime?
  expiresAt       DateTime
  respondedAt     DateTime?

  @@index([billId])
}

// ---------------------------------------------------------------- payments

model Donation {
  id          String         @id @default(cuid())
  billId      String
  bill        Bill           @relation(fields: [billId], references: [id])
  donorId     String
  amount      Decimal        @db.Decimal(12, 2)
  platformTip Decimal        @default(0) @db.Decimal(12, 2)
  gatewayFee  Decimal        @default(0) @db.Decimal(12, 2)
  currency    String
  visibility  Visibility     @default(PUBLIC)
  gatewayRef  String         @unique
  status      DonationStatus @default(INITIATED)
  settledAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([billId])
  @@index([donorId])
}

model Payout {
  id        String   @id @default(cuid())
  billId    String   @unique
  bill      Bill     @relation(fields: [billId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  reference String
  proofUrl  String
  paidAt    DateTime
}

// Written in the same transaction as a state change so events are never lost.
model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt, createdAt])
}

// -------------------------------------------------------------- engagement

model DonorProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  displayName String
  visibility  Visibility   @default(PUBLIC)
  tier        String       @default("BRONZE")
  streakWeeks Int          @default(0)
  badges      DonorBadge[]
}

model Badge {
  id     String       @id @default(cuid())
  key    String       @unique
  name   String
  icon   String
  awards DonorBadge[]
}

model DonorBadge {
  id        String       @id @default(cuid())
  donorId   String
  donor     DonorProfile @relation(fields: [donorId], references: [id])
  badgeId   String
  badge     Badge        @relation(fields: [badgeId], references: [id])
  awardedAt DateTime     @default(now())

  @@unique([donorId, badgeId])
}

model LeaderboardSnapshot {
  id      String  @id @default(cuid())
  period  String
  metric  String
  donorId String
  rank    Int
  value   Decimal @db.Decimal(14, 2)

  @@index([period, metric, rank])
}

model StudentUpdate {
  id        String       @id @default(cuid())
  billId    String
  bill      Bill         @relation(fields: [billId], references: [id])
  body      String
  status    UpdateStatus @default(PENDING)
  createdAt DateTime     @default(now())
}

// ------------------------------------------------------------------- audit

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
